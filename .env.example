# Copy this to .env and fill in real values before deploying.
# Never commit .env to git.

# PostgreSQL credentials
POSTGRES_USER=underwriter
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_DB=gcc_underwriting

# This is also your admin API key (X-Admin-Key header).
# Generate one with: python -c "import secrets; print('admin_' + secrets.token_hex(32))"
API_SECRET_KEY=change_this_to_a_strong_secret

# leave as production on the server
ENVIRONMENT=production
